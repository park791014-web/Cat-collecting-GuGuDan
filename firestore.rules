rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerAdmin() {
      return request.auth != null && request.auth.uid == 'xg6wYMihYRTsF60NCLf36XigPFB3';
    }

    function isNonNegativeInt(value) { return value is int && value >= 0; }
    function hasOnlyAdminTopLevelChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validAdminCurrencyGrant() {
      let changed = request.resource.data.currency.diff(resource.data.currency).affectedKeys();
      return hasOnlyAdminTopLevelChanges(['currency', 'updatedAt'])
        && changed.size() == 1
        && (
          (changed.hasOnly(['coins'])
            && isNonNegativeInt(resource.data.currency.coins)
            && isNonNegativeInt(request.resource.data.currency.coins)
            && request.resource.data.currency.coins - resource.data.currency.coins >= 1
            && request.resource.data.currency.coins - resource.data.currency.coins <= 100000)
          || (changed.hasOnly(['normalTickets'])
            && isNonNegativeInt(resource.data.currency.normalTickets)
            && isNonNegativeInt(request.resource.data.currency.normalTickets)
            && request.resource.data.currency.normalTickets - resource.data.currency.normalTickets >= 1
            && request.resource.data.currency.normalTickets - resource.data.currency.normalTickets <= 100)
          || (changed.hasOnly(['premiumTickets'])
            && isNonNegativeInt(resource.data.currency.premiumTickets)
            && isNonNegativeInt(request.resource.data.currency.premiumTickets)
            && request.resource.data.currency.premiumTickets - resource.data.currency.premiumTickets >= 1
            && request.resource.data.currency.premiumTickets - resource.data.currency.premiumTickets <= 100)
        );
    }

    function validAdminActionCreate(actionId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['actionId', 'adminUid', 'targetUid', 'targetLoginId', 'targetNickname', 'type', 'amount', 'catId', 'catName', 'note', 'before', 'after', 'status', 'createdAt', 'appVersion'])
        && data.keys().hasAll(['actionId', 'adminUid', 'targetUid', 'targetLoginId', 'targetNickname', 'type', 'amount', 'catId', 'catName', 'note', 'before', 'after', 'status', 'createdAt', 'appVersion'])
        && data.actionId == actionId
        && data.adminUid == request.auth.uid
        && data.targetUid is string && data.targetUid.size() >= 6 && data.targetUid.size() <= 128
        && data.targetLoginId is string && data.targetLoginId.size() <= 16
        && data.targetNickname is string && data.targetNickname.size() <= 30
        && data.note is string && data.note.size() <= 100
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.appVersion is string && data.appVersion.size() <= 32
        && ((data.type == 'coins'
          && data.amount is int && data.amount >= 1 && data.amount <= 100000
          && data.before is int && data.before >= 0 && data.after == data.before + data.amount
          && data.catId == null && data.catName == null)
          || (data.type in ['normalTickets', 'premiumTickets']
            && data.amount is int && data.amount >= 1 && data.amount <= 100
            && data.before is int && data.before >= 0 && data.after == data.before + data.amount
            && data.catId == null && data.catName == null));
    }

    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwnerAdmin());
      allow list: if isOwnerAdmin();
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if (request.auth != null && request.auth.uid == uid)
        || (isOwnerAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currency', 'updatedAt'])
          && validAdminCurrencyGrant());
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      allow get, list: if isOwnerAdmin();
      allow create: if isOwnerAdmin() && validAdminActionCreate(actionId);
      allow update, delete: if false;
    }

    match /processedGameSessions/{userSessionId} {
      allow read, create: if request.auth != null && userSessionId.matches('^' + request.auth.uid + '_.*');
      allow update, delete: if false;
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /leaderboardsV3/{entryId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.playerId == request.auth.uid && request.resource.data.rankingVersion == 'v3';
      allow update: if request.auth != null && resource.data.playerId == request.auth.uid && request.resource.data.playerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalScore', 'monthlyScore', 'score', 'nickname', 'representativeCatId', 'playedAt', 'playedAtTimestamp', 'updatedAt']);
      allow delete: if false;
    }

    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow write: if isOwnerAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isOwnerAdmin();
      allow update, delete: if false;
    }
  }
}
